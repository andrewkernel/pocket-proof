{
  "name": "pocket-proof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive optimization laboratory for local AI on Arm-powered devices.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite --host 127.0.0.1\" \"node server/index.js\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "node server/index.js --serve-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "node scripts/verify.mjs",
    "verify:report": "node scripts/verify-report.mjs public/featured-report.json",
    "benchmark": "node scripts/benchmark.mjs",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
